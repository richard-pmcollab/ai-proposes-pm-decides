    {
      "parameters": {
        "jsCode": "// READ-ONLY CONNECTOR. Fictional sample with fixed dates.\n// Swap for Jira, Asana, MS Project, Excel or Google Sheets; keep the same fields.\n// Milestones need: name, baseline, forecast, dependsOn (the milestone before it, if any).\nreturn [{ json: {\n  project: 'Project Atlas: CRM Migration',\n  milestones: [\n    { name: 'Data migration dry run', baseline: '2026-12-01', forecast: '2026-12-08', dependsOn: null },\n    { name: 'UAT start', baseline: '2026-12-15', forecast: '2026-12-17', dependsOn: 'Data migration dry run' },\n    { name: 'Go-live', baseline: '2027-01-12', forecast: '2027-01-12', dependsOn: 'UAT start' }\n  ],\n  criticalTasks: [\n    { id: 'T-102', task: 'Legacy data cleanse (accounts)', owner: 'M. Okafor', due: '2026-11-23', status: 'In Progress', milestone: 'Data migration dry run' },\n    { id: 'T-104', task: 'API integration with billing system', owner: 'R. Patel', due: '2026-11-28', status: 'Blocked', blocker: 'Vendor sandbox credentials', milestone: 'Data migration dry run' },\n    { id: 'T-107', task: 'UAT test scripts', owner: 'S. Nguyen', due: '2026-12-06', status: 'In Progress', milestone: 'UAT start' }\n  ]\n} }];"
      },
      "id": "0ed4e230-92da-4ac4-848f-adfecf4192be",
      "name": "Read Project Tracker",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        496,
        224
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "pmd_milestone_snapshot"
        },
        "returnAll": true
      },
      "id": "37fc2386-50ce-4b62-bdb4-9ec07e76d8e8",
      "name": "Read Yesterday's Snapshot",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        720,
        224
      ],
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// RULES, NOT AI, DECIDE WHETHER TO ALERT.\n// Alert only when a milestone forecast moved by >= alertOnSlipDays since the last snapshot.\n// Quiet days cost nothing: no AI call, no email.\nconst s = $('Settings').first().json;\nconst t = $('Read Project Tracker').first().json;\nconst prev = {};\n$input.all().map(i => i.json).filter(r => r && r.milestone).forEach(r => { prev[r.milestone] = r; });\nconst DAY = 86400000;\nconst diff = (a, b) => Math.round((new Date(a) - new Date(b)) / DAY);\nconst today = new Date().toISOString().slice(0, 10);\n\nconst milestones = t.milestones.map(m => {\n  const p = prev[m.name];\n  const movedDays = p ? diff(m.forecast, p.forecast) : 0;\n  return { ...m, previousForecast: p ? p.forecast : null, movedDays, vsBaselineDays: diff(m.forecast, m.baseline), isNew: !p };\n});\nconst slips = milestones.filter(m => m.movedDays >= s.alertOnSlipDays);\nconst pullIns = milestones.filter(m => m.movedDays < 0);\n\n// Knock-on: any later milestone that depends on a slipped one and has not moved yet\nconst knockOn = milestones.filter(m => m.dependsOn && slips.some(x => x.name === m.dependsOn) && m.movedDays === 0)\n  .map(m => ({ name: m.name, dependsOn: m.dependsOn, forecast: m.forecast }));\nconst relatedTasks = t.criticalTasks.filter(k => slips.some(x => x.name === k.milestone));\n\nreturn [{ json: {\n  project: t.project, today,\n  hasChanges: slips.length > 0,\n  slips, pullIns, knockOn, relatedTasks, milestones,\n  approverEmail: s.approverEmail\n} }];"
      },
      "id": "fef41b84-8115-46af-a068-68f20bd91c8e",
      "name": "Detect Changes (rules)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        224
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nreturn d.milestones.map(m => ({ json: { milestone: m.name, forecast: m.forecast, baseline: m.baseline, captured_on: d.today } }));"
      },
