      "id": "f714ca9b-05e7-433f-8878-2af18ad1e299",
      "name": "Anything Slipped?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        800,
        320
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a schedule analyst. A milestone forecast moved overnight. Using ONLY the data below:\n- headline: one line for the PM.\n- whatMoved: what changed, by how many days, and the likely cause (cite task IDs and blockers from relatedTasks).\n- knockOnRisk: which dependent milestones are exposed (knockOn) and how much buffer is left before they must move. Be precise with dates.\n- options: 2-3 recovery options, each with its trade-off. Do not pick one: the PM decides.\n- raidItem: ONE RAID entry for this slip, with an owner named in the data.\nNever invent dates, people or causes.\n\nPROJECT: {{ $json.project }} · TODAY: {{ $json.today }}\nSLIPPED: {{ JSON.stringify($json.slips) }}\nKNOCK-ON: {{ JSON.stringify($json.knockOn) }}\nRELATED CRITICAL TASKS: {{ JSON.stringify($json.relatedTasks) }}\nALL MILESTONES: {{ JSON.stringify($json.milestones) }}",
        "hasOutputParser": true,
        "batching": {}
      },
      "id": "58013319-37be-4927-a76a-f7b9b831fb56",
      "name": "Impact Analyst",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1024,
        320
      ]
    },
    {
      "parameters": {
        "options": {
          "temperature": 0.1
        }
      },
      "id": "40a09f89-b453-433c-a9f9-aa4e0d52dace",
      "name": "Gemini: Impact",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        1040,
        544
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{ \"headline\": \"Dry run moved 4 days overnight; UAT start now at risk\", \"whatMoved\": \"Plain explanation of the change and its likely cause, citing task IDs\", \"knockOnRisk\": \"Which later milestones are exposed and how many days of buffer remain\", \"options\": [{ \"option\": \"Escalate vendor access to the sponsor today\", \"tradeOff\": \"Uses sponsor goodwill\" }], \"raidItem\": { \"raid_type\": \"Issue\", \"title\": \"Short title\", \"impact\": \"High\", \"likelihood\": \"High\", \"owner\": \"Name from the tracker\", \"mitigation\": \"Concrete action\" } }"
      },
      "id": "84137581-bea3-4f6b-89c8-6e30f235e153",
      "name": "Impact Structure",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1168,
        544
      ]
    },
    {
      "parameters": {
        "jsCode": "const a = $input.first().json.output;\nconst d = $('Detect Changes (rules)').first().json;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst td = 'style=\"border:1px solid #ddd;padding:5px 8px;text-align:left;vertical-align:top\"';\nconst rows = d.milestones.map(m => '<tr' + (m.movedDays > 0 ? ' style=\"background:#fdecea\"' : '') + '><td ' + td + '>' + esc(m.name) + '</td><td ' + td + '>' + esc(m.previousForecast || 'n/a') + '</td><td ' + td + '><b>' + esc(m.forecast) + '</b></td><td ' + td + '>' + (m.movedDays > 0 ? '<b style=\"color:#b00020\">+' + m.movedDays + ' days</b>' : (m.movedDays < 0 ? m.movedDays + ' days' : 'no change')) + '</td><td ' + td + '>' + (m.vsBaselineDays > 0 ? '+' + m.vsBaselineDays : m.vsBaselineDays) + ' vs baseline</td></tr>').join('');\nconst r = a.raidItem || {};\nconst html = '<div style=\"font-family:Segoe UI,Arial,sans-serif;font-size:14px;color:#222;max-width:760px\">'\n  + '<p style=\"font-size:12px;letter-spacing:1px;color:#b00020;margin:0\">SLIP ALERT · AI PROPOSES · YOU DECIDE</p>'\n  + '<h2 style=\"margin:4px 0\">' + esc(a.headline) + '</h2>'\n  + '<p style=\"color:#555;margin-top:0\">' + esc(d.project) + ' · ' + esc(d.today) + '</p>'\n  + '<table style=\"border-collapse:collapse;font-size:13px\"><tr><th ' + td + '>Milestone</th><th ' + td + '>Yesterday</th><th ' + td + '>Today</th><th ' + td + '>Moved</th><th ' + td + '>Baseline</th></tr>' + rows + '</table>'\n  + '<h3>What moved</h3><p>' + esc(a.whatMoved) + '</p>'\n  + '<h3>Knock-on risk</h3><p>' + esc(a.knockOnRisk) + '</p>'\n  + '<h3>Options (you choose)</h3><ol>' + (a.options || []).map(o => '<li><b>' + esc(o.option) + '</b><br><span style=\"color:#555\">Trade-off: ' + esc(o.tradeOff) + '</span></li>').join('') + '</ol>'\n  + '<h3>Proposed RAID entry (added if you acknowledge)</h3>'\n  + '<p>' + esc(r.raid_type) + ': <b>' + esc(r.title) + '</b> · Impact ' + esc(r.impact) + ' · Likelihood ' + esc(r.likelihood) + ' · Owner ' + esc(r.owner) + '<br>Mitigation: ' + esc(r.mitigation) + '</p>'\n  + '<p style=\"font-size:12px;color:#666\">The slip itself was detected by rules (forecast moved overnight), not by AI. Acknowledge to log the RAID entry. Dismiss if it is already handled. Either way the decision is logged and you will not be alerted again for this same change.</p>'\n  + '</div>';\nreturn [{ json: { subject: '[Slip alert] ' + d.project + ': ' + d.slips.map(s => s.name + ' +' + s.movedDays + 'd').join(', '), html } }];"
      },
