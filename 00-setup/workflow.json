    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Adds fictional demo data ONLY to tables that are still empty, so running Setup twice is safe.\nconst empty = (n) => $(n).all().filter(i => i.json && i.json.id).length === 0;\nconst out = [];\nif (empty('Check RAID Log')) [\n  { raid_type: 'Risk', title: 'Billing vendor sandbox access delayed', impact: 'High', likelihood: 'Medium', owner: 'R. Patel', mitigation: 'Weekly check-in with vendor account manager', status: 'Open', source: 'Demo data' },\n  { raid_type: 'Assumption', title: 'Sales reps available for 2 hours of training each', impact: 'Medium', likelihood: 'Medium', owner: 'L. Martin', mitigation: 'Confirm with sales leadership', status: 'Open', source: 'Demo data' }\n].forEach(r => out.push({ json: { target: 'raid', ...r } }));\nif (empty('Check Intake Log')) [\n  { title: 'Add regional sales breakdown to the pipeline dashboard', requester: 'Sales Ops', request_type: 'Change request', size: 'M', priority: 'P2', routed_to: 'A. Chen', status: 'In backlog', source: 'Demo data' },\n  { title: 'Training materials in French for Quebec reps', requester: 'HR', request_type: 'New work', size: 'L', priority: 'P3', routed_to: 'L. Martin', status: 'In backlog', source: 'Demo data' }\n].forEach(r => out.push({ json: { target: 'intake', ...r } }));\nif (empty('Check Retro Feedback')) [\n  ['3', 'Dashboards shipped early and the demo landed well with sales.', 'We found out about the vendor delay from the sponsor, not from our own tracking. Felt late.', 'A shared vendor-dependency tracker we check at standup.'],\n  ['2', 'Pairing on the data mapping helped.', 'Too many ad-hoc requests from sales hitting developers directly. Lost two afternoons.', 'All requests go through the intake form, no DMs.'],\n  ['4', 'Standups were short and useful this sprint.', 'Test environment was down twice and nobody owned getting it fixed.', 'Name an owner for the test environment each sprint.'],\n  ['2', 'Team helped each other when the cleanse slipped.', 'Cleanse work all sat on one person again. Same as last sprint.', 'Split the data cleanse across two people.'],\n  ['3', 'Clear go-live decision from the sponsor.', 'Requests coming in through chat with no priority. Hard to say no.', 'Publish the priority rules so people know what P1 means.'],\n  ['4', 'Dashboards early, nice recognition from sales leadership.', 'Vendor dependency surprised us. We need earlier warning.', '']\n].forEach(r => out.push({ json: { target: 'retro', retro: 'Atlas Sprint 14', mood: r[0], went_well: r[1], to_improve: r[2], ideas: r[3] } }));\nif (empty('Check Milestone Snapshot')) [\n  ['Data migration dry run', '2026-12-04', '2026-12-01'],\n  ['UAT start', '2026-12-17', '2026-12-15'],\n  ['Go-live', '2027-01-12', '2027-01-12']\n].forEach(r => out.push({ json: { target: 'snapshot', milestone: r[0], forecast: r[1], baseline: r[2], captured_on: 'demo' } }));\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
