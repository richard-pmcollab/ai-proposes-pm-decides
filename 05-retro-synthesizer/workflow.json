          "values": [
            {
              "fieldLabel": "Retro / sprint name",
              "fieldName": "retro",
              "placeholder": "e.g. Atlas Sprint 14",
              "requiredField": true
            },
            {
              "fieldLabel": "How did this sprint feel? (1 = rough, 5 = great)",
              "fieldType": "dropdown",
              "fieldName": "mood",
              "fieldOptions": {
                "values": [
                  {
                    "option": "1"
                  },
                  {
                    "option": "2"
                  },
                  {
                    "option": "3"
                  },
                  {
                    "option": "4"
                  },
                  {
                    "option": "5"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "What went well?",
              "fieldType": "textarea",
              "fieldName": "wentWell"
            },
            {
              "fieldLabel": "What should we improve?",
              "fieldType": "textarea",
              "fieldName": "toImprove"
            },
            {
              "fieldLabel": "Any ideas?",
              "fieldType": "textarea",
              "fieldName": "ideas"
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Send anonymously",
          "path": "retro-feedback",
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Thanks. Your feedback was saved anonymously."
