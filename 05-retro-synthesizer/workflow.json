      "id": "442a436d-9779-49b0-992a-4fd8179b2e28",
      "name": "Read Feedback for Retro",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        496,
        544
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// ANONYMITY RULE: no synthesis below the minimum number of responses,\n// because with only one or two people the themes would identify them.\nconst s = $('Settings').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && (r.went_well || r.to_improve || r.ideas));\nconst moods = rows.map(r => Number(r.mood)).filter(n => n >= 1 && n <= 5);\nconst avgMood = moods.length ? Math.round((moods.reduce((a, b) => a + b, 0) / moods.length) * 10) / 10 : null;\nconst teamTo = String(s.teamTo || '').split(/[,;\\s]+/).map(x => x.trim()).filter(x => x.includes('@'));\nreturn [{ json: {\n  retro: String(s.retro).trim(),\n  count: rows.length,\n  enough: rows.length >= s.minResponses,\n  minResponses: s.minResponses,\n  avgMood,\n  feedback: rows.map(r => ({ mood: r.mood, wentWell: r.went_well, toImprove: r.to_improve, ideas: r.ideas })),\n  teamTo,\n  approverEmail: s.approverEmail\n} }];"
      },
      "id": "2220dc84-66b1-456e-bdcf-787b7432fe6e",
      "name": "Check Responses",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        544
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.enough }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "af47baab-cb4b-4a04-8b3d-868317abaea1",
      "name": "Enough Responses?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        944,
        544
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a retrospective facilitator. Synthesize the ANONYMOUS team feedback below for the PM.\n\nRules:\n- Group feedback into themes. count = how many responses mention the theme. Sort by count, highest first.\n- quote: a short verbatim phrase from the feedback. NEVER include a quote that names or clearly identifies a person, role or individual workload. Paraphrase it instead.\n- NEVER guess who wrote anything. Never name people.\n- recurring: true only if the feedback itself says it happened before (e.g. \"again\", \"same as last sprint\").\n- proposedActions: at most 3, each small, concrete and doable in one sprint, with why and a measurable successMeasure. Prefer actions the team itself suggested. Do not assign owners: the team agrees owners in the retro meeting.\n- discussionQuestions: 2-3 open questions to run the retro meeting.\n- teamSummaryEmail: a short, appreciative email to the team: what we heard, the proposed actions, and that owners will be agreed in the retro. No names. Sign off as \"Thanks, the PM\".\n\nRETRO: {{ $json.retro }}\nRESPONSES: {{ $json.count }} · AVERAGE MOOD: {{ $json.avgMood }} / 5\n\nFEEDBACK:\n{{ JSON.stringify($json.feedback) }}",
        "hasOutputParser": true,
        "batching": {}
      },
      "id": "e80919e0-c4ec-4971-9bb7-0203faaae9c6",
      "name": "Retro Analyst",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        800,
        448
      ]
    },
    {
      "parameters": {
        "options": {
          "temperature": 0.2
        }
      },
      "id": "29345ab8-22af-4bea-93fd-ae781e071ed5",
      "name": "Gemini: Retro",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        816,
        672
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{ \"summary\": \"Two sentences on how the sprint went overall\", \"wentWell\": [{ \"theme\": \"Early delivery\", \"count\": 2, \"quote\": \"Dashboards shipped early\" }], \"toImprove\": [{ \"theme\": \"Late warning on vendor dependency\", \"count\": 2, \"quote\": \"Felt late\", \"recurring\": false }], \"proposedActions\": [{ \"action\": \"Add vendor dependencies to the standup board\", \"why\": \"Two people were surprised by the vendor delay\", \"successMeasure\": \"No dependency surprises next sprint\" }], \"discussionQuestions\": [\"What would have warned us earlier?\"], \"teamSummaryEmail\": { \"subject\": \"Sprint 14 retro: what we heard\", \"body\": \"Email body\" } }"
      },
      "id": "3a6f3800-f0d3-4e87-ada4-81ee5b505c5a",
      "name": "Retro Structure",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        944,
        672
      ]
    },
    {
      "parameters": {
        "jsCode": "// Email layout helpers: full width, left aligned, table-based so Outlook renders it consistently.\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst F = 'font-family:Segoe UI,Arial,Helvetica,sans-serif;color:#1f2937;';\nconst T = (t, sub) => '<p style=\"' + F + 'margin:0 0 4px 0;font-size:20px;font-weight:700;line-height:1.3\">' + t + '</p>' + (sub ? '<p style=\"' + F + 'margin:0 0 14px 0;font-size:13px;color:#6b7280\">' + sub + '</p>' : '');\nconst H = (t) => '<p style=\"' + F + 'margin:20px 0 8px 0;font-size:15px;font-weight:700\">' + t + '</p>';\nconst P = (t) => '<p style=\"' + F + 'margin:0 0 10px 0;font-size:14px;line-height:1.5\">' + t + '</p>';\nconst UL = (a) => (a && a.length) ? '<ul style=\"' + F + 'margin:0 0 10px 0;padding:0 0 0 20px;font-size:14px;line-height:1.5\">' + a.map(x => '<li style=\"margin:0 0 4px 0\">' + esc(x) + '</li>').join('') + '</ul>' : P('<em>None</em>');\nconst CELL = F + 'border:1px solid #d1d5db;padding:6px 8px;text-align:left;vertical-align:top;font-size:13px;line-height:1.4;';\nconst TBL = (head, rows) => '<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;margin:0 0 10px 0\">' + (head ? '<tr>' + head.map(h => '<th style=\"' + CELL + 'background:#f3f4f6;font-weight:700\">' + h + '</th>').join('') + '</tr>' : '') + rows.map(r => '<tr>' + r.map(c => '<td style=\"' + CELL + '\">' + c + '</td>').join('') + '</tr>').join('') + '</table>';\nconst BOX = (t, line, bg) => '<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;margin:0 0 12px 0\"><tr><td style=\"' + F + 'background:' + bg + ';border-left:4px solid ' + line + ';padding:10px 12px;font-size:14px;line-height:1.5\">' + t + '</td></tr></table>';\nconst PILL = (t, bg) => '<span style=\"background:' + bg + ';color:#ffffff;padding:2px 10px;border-radius:10px;font-weight:700;font-size:12px\">' + t + '</span>';\nconst BTN = '<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:16px 0\"><tr><td style=\"background:#1f4e79;border-radius:4px\"><a href=\"%%DECIDE_URL%%\" style=\"' + F + 'display:inline-block;padding:11px 22px;color:#ffffff;font-size:14px;font-weight:700;text-decoration:none\">Review and decide</a></td></tr></table>';\nconst NOTE = (t) => '<p style=\"' + F + 'margin:16px 0 0 0;font-size:12px;line-height:1.5;color:#6b7280\">' + t + '</p>';\nconst WRAP = (inner) => '<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse\"><tr><td style=\"' + F + 'padding:0;text-align:left\">' + inner + '</td></tr></table>';\nconst RAG = { Green: '#1e7e34', Amber: '#b26a00', Red: '#b00020' };\nconst x = $input.first().json.output;\nconst c = $('Check Responses').first().json;\nconst themes = (list, showRec) => (list && list.length) ? TBL(['Theme', 'Mentions', 'In their words'], list.map(t => [esc(t.theme) + (showRec && t.recurring ? ' <span style=\"color:#b00020;font-weight:700\">(recurring)</span>' : ''), esc(t.count), '<i>\"' + esc(t.quote) + '\"</i>'])) : P('<em>None</em>');\nconst acts = (x.proposedActions || []).length ? TBL(['Proposed action', 'Why', 'Success measure'], x.proposedActions.map(a => ['<b>' + esc(a.action) + '</b>', esc(a.why), esc(a.successMeasure)])) : P('<em>No actions proposed</em>');\nconst body = T('Retro synthesis: ' + esc(c.retro), c.count + ' anonymous responses · average mood ' + (c.avgMood === null ? 'n/a' : c.avgMood + ' / 5'))\n  + P(esc(x.summary)) + BTN\n  + H('What went well') + themes(x.wentWell, false)\n  + H('What to improve') + themes(x.toImprove, true)\n  + H('Proposed actions (logged as UNASSIGNED if you approve; owners agreed in the retro)') + acts\n  + H('Questions to open the retro') + UL(x.discussionQuestions)\n  + H('Team summary (saved as a draft if you approve)') + BOX('<b>' + esc(x.teamSummaryEmail.subject) + '</b><br>' + esc(x.teamSummaryEmail.body).replace(/\\n/g, '<br>'), '#9ca3af', '#f9fafb')\n  + BTN\n  + NOTE('Check the quotes: none should identify a person. Nothing has been saved yet. Approve to log the actions and save the team summary as a draft. Reject to discard. Your decision and comment are saved in the audit log.');\nreturn [{ json: { subject: '[Approval needed] Retro synthesis: ' + c.retro + ' (' + c.count + ' responses)', html: WRAP(body) } }];\n"
      },
