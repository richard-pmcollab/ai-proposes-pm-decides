    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "pmd_retro_feedback"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "retro",
              "keyValue": "={{ $json.retro.trim() }}"
            }
          ]
        },
        "returnAll": true
      },
      "id": "442a436d-9779-49b0-992a-4fd8179b2e28",
      "name": "Read Feedback for Retro",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        496,
        544
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// ANONYMITY RULE: no synthesis below the minimum number of responses,\n// because with only one or two people the themes would identify them.\nconst s = $('Settings').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && (r.went_well || r.to_improve || r.ideas));\nconst moods = rows.map(r => Number(r.mood)).filter(n => n >= 1 && n <= 5);\nconst avgMood = moods.length ? Math.round((moods.reduce((a, b) => a + b, 0) / moods.length) * 10) / 10 : null;\nconst teamTo = String(s.teamTo || '').split(/[,;\\s]+/).map(x => x.trim()).filter(x => x.includes('@'));\nreturn [{ json: {\n  retro: String(s.retro).trim(),\n  count: rows.length,\n  enough: rows.length >= s.minResponses,\n  minResponses: s.minResponses,\n  avgMood,\n  feedback: rows.map(r => ({ mood: r.mood, wentWell: r.went_well, toImprove: r.to_improve, ideas: r.ideas })),\n  teamTo,\n  approverEmail: s.approverEmail\n} }];"
      },
      "id": "2220dc84-66b1-456e-bdcf-787b7432fe6e",
      "name": "Check Responses",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        544
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.enough }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "af47baab-cb4b-4a04-8b3d-868317abaea1",
      "name": "Enough Responses?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        944,
        544
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a retrospective facilitator. Synthesize the ANONYMOUS team feedback below for the PM.\n\nRules:\n- Group feedback into themes. count = how many responses mention the theme. Sort by count, highest first.\n- quote: a short verbatim phrase from the feedback. NEVER include a quote that names or clearly identifies a person, role or individual workload. Paraphrase it instead.\n- NEVER guess who wrote anything. Never name people.\n- recurring: true only if the feedback itself says it happened before (e.g. \"again\", \"same as last sprint\").\n- proposedActions: at most 3, each small, concrete and doable in one sprint, with why and a measurable successMeasure. Prefer actions the team itself suggested. Do not assign owners: the team agrees owners in the retro meeting.\n- discussionQuestions: 2-3 open questions to run the retro meeting.\n- teamSummaryEmail: a short, appreciative email to the team: what we heard, the proposed actions, and that owners will be agreed in the retro. No names. Sign off as \"Thanks, the PM\".\n\nRETRO: {{ $json.retro }}\nRESPONSES: {{ $json.count }} · AVERAGE MOOD: {{ $json.avgMood }} / 5\n\nFEEDBACK:\n{{ JSON.stringify($json.feedback) }}",
        "hasOutputParser": true,
        "batching": {}
      },
      "id": "e80919e0-c4ec-4971-9bb7-0203faaae9c6",
      "name": "Retro Analyst",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        800,
        448
      ]
    },
    {
      "parameters": {
        "options": {
          "temperature": 0.2
        }
      },
      "id": "29345ab8-22af-4bea-93fd-ae781e071ed5",
      "name": "Gemini: Retro",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        816,
        672
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{ \"summary\": \"Two sentences on how the sprint went overall\", \"wentWell\": [{ \"theme\": \"Early delivery\", \"count\": 2, \"quote\": \"Dashboards shipped early\" }], \"toImprove\": [{ \"theme\": \"Late warning on vendor dependency\", \"count\": 2, \"quote\": \"Felt late\", \"recurring\": false }], \"proposedActions\": [{ \"action\": \"Add vendor dependencies to the standup board\", \"why\": \"Two people were surprised by the vendor delay\", \"successMeasure\": \"No dependency surprises next sprint\" }], \"discussionQuestions\": [\"What would have warned us earlier?\"], \"teamSummaryEmail\": { \"subject\": \"Sprint 14 retro: what we heard\", \"body\": \"Email body\" } }"
      },
      "id": "3a6f3800-f0d3-4e87-ada4-81ee5b505c5a",
      "name": "Retro Structure",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        944,
        672
      ]
    },
    {
      "parameters": {
        "jsCode": "const x = $input.first().json.output;\nconst c = $('Check Responses').first().json;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst td = 'style=\"border:1px solid #ddd;padding:5px 8px;text-align:left;vertical-align:top\"';\nconst themes = (list, showRec) => (list && list.length)\n  ? '<table style=\"border-collapse:collapse;font-size:13px\"><tr><th ' + td + '>Theme</th><th ' + td + '>Mentions</th><th ' + td + '>In their words</th></tr>'\n    + list.map(t => '<tr><td ' + td + '>' + esc(t.theme) + (showRec && t.recurring ? ' <span style=\"color:#b00020;font-weight:600\">↻ recurring</span>' : '') + '</td><td ' + td + '>' + esc(t.count) + '</td><td ' + td + '><i>\"' + esc(t.quote) + '\"</i></td></tr>').join('') + '</table>'\n  : '<p><em>None</em></p>';\nconst actions = (x.proposedActions || []).length\n  ? '<ol>' + x.proposedActions.map(a => '<li><b>' + esc(a.action) + '</b><br><span style=\"color:#555\">Why: ' + esc(a.why) + ' · Success: ' + esc(a.successMeasure) + '</span></li>').join('') + '</ol>'\n  : '<p><em>No actions proposed</em></p>';\nconst mood = c.avgMood === null ? 'n/a' : c.avgMood + ' / 5';\nconst html = '<div style=\"font-family:Segoe UI,Arial,sans-serif;font-size:14px;color:#222;max-width:760px\">'\n  + '<p style=\"font-size:12px;letter-spacing:1px;color:#b00020;margin:0\">AI PROPOSES · YOU DECIDE</p>'\n  + '<h2 style=\"margin:4px 0\">Retro synthesis: ' + esc(c.retro) + '</h2>'\n  + '<p style=\"color:#555;margin-top:0\">' + c.count + ' anonymous responses · average mood ' + mood + '</p>'\n  + '<p>' + esc(x.summary) + '</p>'\n  + '<h3>What went well</h3>' + themes(x.wentWell, false)\n  + '<h3>What to improve</h3>' + themes(x.toImprove, true)\n  + '<h3>Proposed actions (added to the action log as UNASSIGNED if you approve; owners agreed in the retro)</h3>' + actions\n  + '<h3>Questions to open the retro</h3><ul>' + (x.discussionQuestions || []).map(q => '<li>' + esc(q) + '</li>').join('') + '</ul>'\n  + '<h3>Team summary (saved as a draft if you approve)</h3>'\n  + '<div style=\"border-left:3px solid #ccc;padding:6px 12px;background:#fafafa\"><b>' + esc(x.teamSummaryEmail.subject) + '</b><br>' + esc(x.teamSummaryEmail.body).replace(/\\n/g, '<br>') + '</div>'\n  + '<p style=\"font-size:12px;color:#666\">Check the quotes: none should identify a person. Nothing has been saved yet. Approve to log the actions and save the team summary as a draft. Reject to discard. Your decision is logged either way.</p>'\n  + '</div>';\nreturn [{ json: { subject: '[Approval needed] Retro synthesis: ' + c.retro + ' (' + c.count + ' responses)', html } }];"
      },
      "id": "1a3de33a-c652-4502-aef5-25fd42a1ecc5",
      "name": "Format Proposal for PM",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
