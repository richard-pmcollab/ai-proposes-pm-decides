      "id": "3efe3a14-77be-4e3c-a4b7-88d4f201f095",
      "name": "Read Intake Log",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        496,
        224
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// PRIORITY IS SET BY RULES HERE, NOT BY THE AI.\n// P1: blocks work or hits customers/revenue AND needed within 14 days\n// P2: blocks work or hits customers/revenue, OR needed within 14 days\n// P3: everything else\nconst f = $('Settings').first().json;\nconst existing = $input.all().map(i => i.json).filter(r => r && r.title)\n  .map(r => ({ title: r.title, status: r.status, routed_to: r.routed_to }));\nconst serious = f.impact === 'Blocks our work' || f.impact === 'Affects customers or revenue';\nlet daysLeft = null;\nif (f.neededBy) {\n  const today = new Date(); today.setHours(0, 0, 0, 0);\n  daysLeft = Math.round((new Date(f.neededBy) - today) / 86400000);\n}\nconst soon = daysLeft !== null && daysLeft <= 14;\nconst priority = serious && soon ? 'P1' : (serious || soon ? 'P2' : 'P3');\nconst reason = (serious ? f.impact : 'Improvement') + (daysLeft === null ? ', no deadline' : ', needed in ' + daysLeft + ' day(s)');\nreturn [{ json: {\n  requesterName: String(f.requesterName || '').trim(),\n  requesterEmail: String(f.requesterEmail || '').trim(),\n  department: String(f.department || '').trim(),\n  title: String(f.title || '').trim(),\n  description: String(f.description || '').trim().slice(0, 15000),\n  impact: f.impact,\n  neededBy: f.neededBy || 'Not given',\n  priority, priorityReason: reason,\n  routingTable: f.routingTable,\n  existingRequests: existing,\n  approverEmail: f.approverEmail\n} }];"
      },
      "id": "cf85ca6d-d2d2-4848-9ed4-312b5048dbae",
      "name": "Prepare and Prioritise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        224
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are the intake analyst for a project team. Triage the request below for the PM.\n\n1. requestType: one of Bug, Change request, New work, Support, Question.\n2. summary: one plain sentence restating what is needed and why.\n3. size: S (under a day), M (a few days), L (1-3 weeks), XL (more than 3 weeks or needs its own project). Give a one-line reason. If the description is too vague to size, say so in sizeReason and pick the most likely size.\n4. routeTo: pick ONE owner from this routing table and explain why: {{ $json.routingTable }}\n5. possibleDuplicateOf: if the request overlaps with one of the EXISTING REQUESTS, give its exact title. Otherwise an empty string.\n6. missingInfo: questions the team needs answered before starting. Empty list if nothing is missing.\n7. replyToRequester: a short, warm, professional email to {{ $json.requesterName }}: thank them, restate your understanding in one line, say it has been logged as priority {{ $json.priority }} and the PM will confirm next steps, and ask the missingInfo questions if any. NEVER promise a delivery date. Under 120 words. Sign off as \"The project team\".\n\nPriority is already set by rules ({{ $json.priority }}: {{ $json.priorityReason }}). Do not change it.\nUse only what is in the request. Never invent details.\n\nREQUEST\nFrom: {{ $json.requesterName }} ({{ $json.department || \"department not given\" }})\nTitle: {{ $json.title }}\nImpact: {{ $json.impact }}\nNeeded by: {{ $json.neededBy }}\nDescription:\n{{ $json.description }}\n\nEXISTING REQUESTS:\n{{ JSON.stringify($json.existingRequests) }}",
        "hasOutputParser": true,
        "batching": {}
      },
      "id": "27e31816-a50f-471b-9b0b-844d1c5cccc8",
      "name": "Intake Analyst",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        800,
        224
      ]
    },
    {
      "parameters": {
        "options": {
          "temperature": 0.2
        }
      },
      "id": "c06ea9ec-7a6c-4548-96b6-420d961ddc22",
      "name": "Gemini: Triage",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        816,
        448
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{ \"requestType\": \"Change request\", \"summary\": \"One sentence restating what is needed and why\", \"size\": \"M\", \"sizeReason\": \"Why this size\", \"routeTo\": \"A. Chen\", \"routeReason\": \"Why this owner\", \"possibleDuplicateOf\": \"Title of an existing request, or empty\", \"missingInfo\": [\"Question to ask the requester\"], \"replyToRequester\": { \"subject\": \"Re: request title\", \"body\": \"Reply body\" } }"
      },
      "id": "ce481f5b-bdc5-43c2-9931-62a1856e8b63",
      "name": "Triage Structure",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        944,
        448
      ]
    },
    {
      "parameters": {
        "jsCode": "const t = $input.first().json.output;\nconst r = $('Prepare and Prioritise').first().json;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst ul = (a) => a && a.length ? '<ul>' + a.map(x => '<li>' + esc(x) + '</li>').join('') + '</ul>' : '<p><em>Nothing missing</em></p>';\nconst pc = { P1: '#b00020', P2: '#b26a00', P3: '#1e7e34' };\nconst td = 'style=\"border:1px solid #ddd;padding:5px 8px;text-align:left;vertical-align:top\"';\nconst row = (k, v) => '<tr><th ' + td + '>' + k + '</th><td ' + td + '>' + v + '</td></tr>';\nconst dup = t.possibleDuplicateOf ? '<p style=\"background:#fff3e0;border-left:4px solid #b26a00;padding:8px 12px\"><b>Possible duplicate</b> of an existing request: <i>' + esc(t.possibleDuplicateOf) + '</i>. Consider merging instead of logging a new item.</p>' : '';\nconst html = '<div style=\"font-family:Segoe UI,Arial,sans-serif;font-size:14px;color:#222;max-width:760px\">'\n  + '<p style=\"font-size:12px;letter-spacing:1px;color:#b00020;margin:0\">AI PROPOSES · YOU DECIDE</p>'\n  + '<h2 style=\"margin:4px 0\">New request: ' + esc(r.title) + '</h2>'\n  + '<p style=\"color:#555;margin-top:0\">From ' + esc(r.requesterName) + (r.department ? ' (' + esc(r.department) + ')' : '') + ' · ' + esc(r.requesterEmail) + '</p>'\n  + dup\n  + '<table style=\"border-collapse:collapse;font-size:13px\">'\n  + row('Priority (rules)', '<span style=\"background:' + pc[r.priority] + ';color:#fff;padding:2px 8px;border-radius:8px;font-weight:600\">' + r.priority + '</span> ' + esc(r.priorityReason))\n  + row('Type', esc(t.requestType))\n  + row('Summary', esc(t.summary))\n  + row('Size estimate', '<b>' + esc(t.size) + '</b>: ' + esc(t.sizeReason))\n  + row('Route to', '<b>' + esc(t.routeTo) + '</b>: ' + esc(t.routeReason))\n  + '</table>'\n  + '<h3>Missing information</h3>' + ul(t.missingInfo)\n  + '<h3>Reply to requester (saved as a draft if you approve)</h3>'\n  + '<div style=\"border-left:3px solid #ccc;padding:6px 12px;background:#fafafa\"><b>' + esc(t.replyToRequester.subject) + '</b><br>' + esc(t.replyToRequester.body).replace(/\\n/g, '<br>') + '</div>'\n  + '<h3>Original request</h3><div style=\"font-size:13px;color:#444;border-left:3px solid #eee;padding:6px 12px\">' + esc(r.description).replace(/\\n/g, '<br>') + '</div>'\n  + '<p style=\"font-size:12px;color:#666\">Nothing has been logged yet. Approve to add it to the intake log and save the reply as a draft. Reject to discard (no reply is drafted). Your decision is logged either way.</p>'\n  + '</div>';\nreturn [{ json: { subject: '[Approval needed] ' + r.priority + ' request: ' + r.title + (t.possibleDuplicateOf ? ' (possible duplicate)' : ''), html } }];"
      },
