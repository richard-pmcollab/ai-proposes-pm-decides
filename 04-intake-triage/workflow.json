{
  "name": "AI Proposes, PM Decides: 04 Intake Triage",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Submit a request to the project team",
        "formDescription": "Tell us what you need. The PM reviews every request and you will hear back with next steps.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Your name",
              "fieldName": "requesterName",
              "requiredField": true
            },
            {
              "fieldLabel": "Your email",
              "fieldType": "email",
              "fieldName": "requesterEmail",
              "requiredField": true
            },
            {
              "fieldLabel": "Your team or department",
              "fieldName": "department",
              "placeholder": "e.g. Sales Operations"
            },
            {
              "fieldLabel": "Request title",
              "fieldName": "title",
              "placeholder": "One line, e.g. Add region filter to pipeline dashboard",
              "requiredField": true
            },
            {
              "fieldLabel": "Describe what you need and why",
              "fieldType": "textarea",
              "fieldName": "description",
              "requiredField": true
            },
            {
              "fieldLabel": "Business impact",
              "fieldType": "dropdown",
              "fieldName": "impact",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Blocks our work"
                  },
                  {
                    "option": "Affects customers or revenue"
                  },
                  {
                    "option": "Improvement / nice to have"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Needed by (optional)",
              "fieldType": "date",
              "fieldName": "neededBy"
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Submit request",
          "path": "project-intake",
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Thanks. Your request is with the project team and you will get a reply once the PM has reviewed it."
            }
          }
        }
      },
