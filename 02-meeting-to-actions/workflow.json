{
  "name": "AI Proposes, PM Decides: 02 Meeting → Actions",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Meeting → Actions",
        "formDescription": "Paste a meeting transcript or your rough notes. The agent proposes decisions, actions, owners and risks, and emails them to you for approval. Nothing is saved until you approve.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Meeting name",
              "fieldName": "meetingName",
              "placeholder": "e.g. Project Atlas weekly sync",
              "requiredField": true
            },
            {
              "fieldLabel": "Meeting date",
              "fieldType": "date",
              "fieldName": "meetingDate",
              "requiredField": true
            },
            {
              "fieldLabel": "Attendee emails (for the follow-up draft)",
              "fieldName": "attendees",
              "placeholder": "name@company.com, name2@company.com"
            },
            {
              "fieldLabel": "Transcript or notes",
              "fieldType": "textarea",
              "fieldName": "transcript",
              "placeholder": "Paste the Teams/Zoom transcript or your notes here",
              "requiredField": true
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Send to agent",
          "path": "meeting-to-actions",
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Got it. The agent is reading your meeting. You will get an approval email in about a minute."
            }
          }
        }
      },
      "id": "63f2a1f4-c79f-488e-bd55-29ea7fce7cfd",
      "name": "PM Input Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        96
      ],
      "webhookId": "cb7840c1-6e3d-4cf9-bb76-3e0c78f20226"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "approver",
              "name": "approverEmail",
              "value": "YOUR_EMAIL@example.com",
              "type": "string"
            },
            {
              "id": "pause",
              "name": "pauseSeconds",
              "value": 13,
              "type": "number"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "171a2edc-6d98-4d71-94b4-942842ca1cc1",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        272,
        224
      ]
    },
    {
      "parameters": {
        "jsCode": "// Basic hygiene before the AI sees the text: trim, cap length, tidy attendee list.\nconst f = $input.first().json;\nconst MAX = 40000;\nlet transcript = String(f.transcript || '').trim();\nconst truncated = transcript.length > MAX;\nif (truncated) transcript = transcript.slice(0, MAX);\nconst attendees = String(f.attendees || '').split(/[,;\\s]+/).map(s => s.trim()).filter(s => s.includes('@'));\nreturn [{ json: {\n  meetingName: String(f.meetingName || 'Untitled meeting').trim(),\n  meetingDate: f.meetingDate,\n  attendees,\n  transcript,\n  truncated,\n  approverEmail: f.approverEmail,\n  pauseSeconds: f.pauseSeconds\n} }];"
      },
      "id": "969ce4b5-263c-4866-8d97-0020c87c52dc",
      "name": "Prepare Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        496,
        224
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a meeting analyst on a PM team. Read the meeting below and extract what was decided, what people committed to do, new risks or issues, and open questions.\n\nRules:\n- Use ONLY what is in the text. Never invent people, dates or commitments.\n- An action needs a clear owner. If nobody clearly took it, set owner to \"UNASSIGNED\".\n- dueDate only if a date or day was stated (convert relative days like \"Friday\" using the meeting date {{ $json.meetingDate }}). Otherwise \"TBD\".\n- confidence: High if the owner explicitly agreed, Medium if implied, Low if unclear.\n- sourceQuote: the short phrase from the text that supports the action.\n- Risks: only genuine risks or issues raised in the meeting, with impact and likelihood High/Medium/Low.\n- Ignore small talk.\n\nMEETING: {{ $json.meetingName }} ({{ $json.meetingDate }})\n\nTRANSCRIPT / NOTES:\n{{ $json.transcript }}",
        "hasOutputParser": true,
        "batching": {}
      },
      "id": "d982a6e5-8618-4dde-acba-59f8721f3040",
      "name": "Meeting Analyst",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        800,
        224
      ]
    },
    {
      "parameters": {
        "options": {
          "temperature": 0.1
        }
      },
      "id": "2b1b86b7-37e6-44ad-8b03-15bd40c43ddc",
      "name": "Gemini: Extract",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        816,
        448
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{ \"summary\": \"Two or three sentences on what the meeting was about and what it settled.\", \"decisions\": [{ \"decision\": \"Go-live stays on 12 January\", \"madeBy\": \"Sponsor\" }], \"actions\": [{ \"action\": \"Escalate sandbox access with the billing vendor\", \"owner\": \"R. Patel\", \"dueDate\": \"2026-11-28\", \"confidence\": \"High\", \"sourceQuote\": \"Raj, can you chase the vendor by Friday?\" }], \"risks\": [{ \"raid_type\": \"Risk\", \"title\": \"Short title\", \"impact\": \"High\", \"likelihood\": \"Medium\", \"owner\": \"Name\", \"mitigation\": \"Concrete action\" }], \"openQuestions\": [\"Who owns the training demo?\"] }"
      },
      "id": "b0ec2ea5-a48b-4e95-9f49-146d52c87a13",
      "name": "Meeting Structure",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        944,
        448
      ]
    },
    {
      "parameters": {
        "amount": "={{ $(\"Prepare Input\").first().json.pauseSeconds }}"
      },
      "id": "a19084f7-0522-4d0f-93b7-71461a8e42a2",
      "name": "Pace",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1152,
        224
      ],
      "webhookId": "84427c3c-eb71-48ca-b2e7-367db676b030"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You write meeting follow-up emails for a project manager. Using ONLY the extracted items below, write a short follow-up email to the attendees: one-line thanks, a short summary, Decisions, Actions (owner and due date for each), and Open questions. Clear, friendly, professional. Under 200 words. Plain text. Sign off as \"Thanks\". Do not add anything that is not in the items.\n\nMEETING: {{ $(\"Prepare Input\").first().json.meetingName }} ({{ $(\"Prepare Input\").first().json.meetingDate }})\n\nEXTRACTED ITEMS:\n{{ JSON.stringify($(\"Meeting Analyst\").first().json.output) }}",
        "hasOutputParser": true,
        "batching": {}
      },
      "id": "98cda299-5055-4d47-8229-2f7c0e713b20",
      "name": "Follow-up Writer",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1376,
        224
      ]
    },
    {
      "parameters": {
        "options": {
          "temperature": 0.3
        }
      },
      "id": "7c82c225-fe1a-4697-b3e7-f9de943e4be0",
      "name": "Gemini: Follow-up",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        1392,
        448
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{ \"subject\": \"Follow-up: Project Atlas weekly sync (26 Nov)\", \"body\": \"Email body\" }"
      },
      "id": "1fa89b7f-116c-40a3-be68-065818e4789c",
      "name": "Follow-up Structure",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1520,
        448
      ]
    },
    {
      "parameters": {
        "jsCode": "const m = $('Meeting Analyst').first().json.output;\nconst f = $input.first().json.output;\nconst inp = $('Prepare Input').first().json;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst ul = (a) => a && a.length ? '<ul>' + a.map(x => '<li>' + esc(x) + '</li>').join('') + '</ul>' : '<p><em>None</em></p>';\nconst td = 'style=\"border:1px solid #ddd;padding:5px 8px;text-align:left;vertical-align:top\"';\nconst flag = (a) => (a.owner === 'UNASSIGNED' || a.confidence === 'Low') ? ' style=\"background:#fff3e0\"' : '';\nconst actions = (m.actions || []).length\n  ? '<table style=\"border-collapse:collapse;font-size:13px\"><tr><th ' + td + '>Action</th><th ' + td + '>Owner</th><th ' + td + '>Due</th><th ' + td + '>Confidence</th><th ' + td + '>From the meeting</th></tr>'\n    + m.actions.map(a => '<tr' + flag(a) + '><td ' + td + '>' + esc(a.action) + '</td><td ' + td + '>' + esc(a.owner) + '</td><td ' + td + '>' + esc(a.dueDate) + '</td><td ' + td + '>' + esc(a.confidence) + '</td><td ' + td + '><i>\"' + esc(a.sourceQuote) + '\"</i></td></tr>').join('') + '</table>'\n    + '<p style=\"font-size:12px;color:#666\">Highlighted rows have no clear owner or low confidence. Check them before approving.</p>'\n  : '<p><em>No actions found</em></p>';\nconst risks = (m.risks || []).length\n  ? '<table style=\"border-collapse:collapse;font-size:13px\"><tr><th ' + td + '>Type</th><th ' + td + '>Title</th><th ' + td + '>Impact</th><th ' + td + '>Likelihood</th><th ' + td + '>Owner</th><th ' + td + '>Mitigation</th></tr>'\n    + m.risks.map(r => '<tr><td ' + td + '>' + esc(r.raid_type) + '</td><td ' + td + '>' + esc(r.title) + '</td><td ' + td + '>' + esc(r.impact) + '</td><td ' + td + '>' + esc(r.likelihood) + '</td><td ' + td + '>' + esc(r.owner) + '</td><td ' + td + '>' + esc(r.mitigation) + '</td></tr>').join('') + '</table>'\n  : '<p><em>No new risks</em></p>';\n\nconst html = '<div style=\"font-family:Segoe UI,Arial,sans-serif;font-size:14px;color:#222;max-width:760px\">'\n  + '<p style=\"font-size:12px;letter-spacing:1px;color:#b00020;margin:0\">AI PROPOSES · YOU DECIDE</p>'\n  + '<h2 style=\"margin:4px 0\">' + esc(inp.meetingName) + ' · ' + esc(inp.meetingDate) + '</h2>'\n  + (inp.truncated ? '<p style=\"color:#b00020\">Note: the transcript was very long and only the first part was analysed.</p>' : '')\n  + '<p>' + esc(m.summary) + '</p>'\n  + '<h3>1 · Decisions</h3>' + ul((m.decisions || []).map(d => d.decision + (d.madeBy ? ' (' + d.madeBy + ')' : '')))\n  + '<h3>2 · Actions (will be added to the action log if you approve)</h3>' + actions\n  + '<h3>3 · New risks and issues (will be added to the RAID log if you approve)</h3>' + risks\n  + '<h3>4 · Open questions</h3>' + ul(m.openQuestions)\n  + '<h3>5 · Follow-up email (will be saved as a draft to ' + (inp.attendees.length ? esc(inp.attendees.join(', ')) : 'no recipients yet') + ')</h3>'\n  + '<div style=\"border-left:3px solid #ccc;padding:6px 12px;background:#fafafa\"><b>' + esc(f.subject) + '</b><br>' + esc(f.body).replace(/\\n/g, '<br>') + '</div>'\n  + '<p style=\"font-size:12px;color:#666\">Nothing has been saved yet. Approve to log the actions and risks and save the follow-up as a draft. Reject to discard. Your decision is logged either way.</p>'\n  + '</div>';\nreturn [{ json: { subject: '[Approval needed] Actions from ' + inp.meetingName, html } }];"
      },
      "id": "3fdb9722-37b5-430e-96b5-2fb2e264c125",
      "name": "Format Proposal for PM",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1728,
        224
      ]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "toRecipients": "={{ $(\"Prepare Input\").first().json.approverEmail }}",
        "subject": "={{ $json.subject }}",
        "message": "={{ $json.html }}",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Approve and apply",
            "disapproveLabel": "Reject"
          }
        },
        "options": {
          "limitWaitTime": {
            "values": {
              "resumeAmount": 2,
              "resumeUnit": "days"
            }
          },
          "appendAttribution": false
        }
