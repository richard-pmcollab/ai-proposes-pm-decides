    {
      "parameters": {
        "jsCode": "const m = $('Meeting Analyst').first().json.output;\nconst inp = $('Prepare Input').first().json;\nconst src = 'Meeting run ' + $execution.id + ' (PM approved)';\nconst actions = (m.actions || []).map(a => ({ json: { target: 'action', meeting: inp.meetingName, meeting_date: inp.meetingDate, action: a.action, owner: a.owner, due_date: a.dueDate, status: 'Open', source: src } }));\nconst risks = (m.risks || []).map(r => ({ json: { target: 'raid', raid_type: r.raid_type, title: r.title, impact: r.impact, likelihood: r.likelihood, owner: r.owner, mitigation: r.mitigation, status: 'Open', source: src } }));\nreturn actions.concat(risks);"
      },
      "id": "76ee7683-7363-4221-847a-6b4dc9f70854",
      "name": "Split Actions and Risks",
